# DATABASE
DATABASE_URL=mongodb://localhost:27017/subscription-app
NODE_ENV=development
PORT=5000
IP_ADDRESS=localhost
BCRYPT_SALT_ROUNDS=12

# JWT
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRE_IN=7d
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-this
JWT_REFRESH_EXPIRES_IN=30d

# EMAIL
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# ADMIN
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=secure-admin-password

# STRIPE (Get these from Stripe Dashboard)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXX

# APP URLs
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# SUBSCRIPTION MONITORING (optional)
# Schedule format: "0 */6 * * *" (cron expression)
# Default: every 6 hours
SUBSCRIPTION_MONITOR_SCHEDULE=0 */6 * * *

# NOTES:
# 1. For Stripe keys, go to https://dashboard.stripe.com/apikeys
# 2. For Webhook Secret, go to https://dashboard.stripe.com/webhooks
# 3. Test card: 4242 4242 4242 4242 (expires: any future date, CVC: any 3 digits)
# 4. In production, ensure HTTPS is enabled for webhook endpoint
# 5. Change all default secrets to strong random values
